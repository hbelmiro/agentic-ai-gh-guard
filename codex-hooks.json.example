{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /absolute/path/to/src/gh_guard.py --log-level info --hook-target codex",
            "statusMessage": "Checking GitHub CLI approval"
          }
        ]
      }
    ]
  }
}
